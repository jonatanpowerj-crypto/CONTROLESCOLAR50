rules_version = '2';
// ════════════════════════════════════════════════════════════════
// REGLAS DE SEGURIDAD — SIGE Prepa 50 (Firestore)
// Cópialo y pégalo en: Firestore → pestaña Reglas → Publicar
//
// SEGURIDAD DEL PORTAL DE ALUMNOS (FASE IMPLEMENTADA):
//   - allow get: if true → Cualquiera puede LEER UN documento si ya
//     conoce su ID exacto (la matrícula). Esto es para el portal
//     público de consulta donde el padre/alumno conoce la matrícula.
//   - allow list: if request.auth != null → Solo usuarios autenticados
//     pueden LISTAR todos los documentos de una colección. Esto impide
//     que alguien sin sesión pueda descargar toda la colección.
//
// ESTRUCTURA DE SUBCOLECCIONES:
//   - calificaciones y asistencias ahora son subcolecciones de:
//     alumnos/{matricula}/calificaciones/{id}
//     alumnos/{matricula}/asistencias/{id}
//
// ESCRITURA:
//   - Solo usuarios con sesión (docentes/administradores) pueden
//     escribir datos del sistema.
// ════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección alumnos: documento por matrícula
    match /alumnos/{matricula} {
      // allow get: if true → Lectura de UN alumno por matrícula (portal público)
      allow get: if true;
      // allow list: Solo con sesión → No se puede listar todos los alumnos
      allow list: if request.auth != null;
      // allow write: Solo con sesión → Solo docentes/admins pueden modificar
      allow write: if request.auth != null;

      // Subcolección calificaciones del alumno
      match /calificaciones/{id} {
        allow get, list: if true;
        allow write: if request.auth != null;
      }

      // Subcolección assistencias del alumno
      match /asistencias/{id} {
        allow get, list: if true;
        allow write: if request.auth != null;
      }
    }

    // Bandeja de entrada de la app de registro de docentes:
    match /registros_docentes/{doc} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // ─── COLECCIONES RAÍZ ───
    match /docentes/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /materias/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /grupos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /horarios/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /calendario/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── REGLA GENERAL DE SEGURIDAD ───
    match /{coleccion}/{documento=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
